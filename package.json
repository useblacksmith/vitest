{
	"name": "@useblacksmith/vitest",
	"version": "0.2.0",
	"description": "Reports Vitest test results to Blacksmith and runs only the tests affected since the last run",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "node build.mjs",
		"prepack": "npm run build",
		"check:types": "tsc --noEmit",
		"test": "vitest run",
		"build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly"
	},
	"peerDependencies": {
		"vitest": ">=5.1.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.6",
		"@types/picomatch": "^4.0.3",
		"esbuild": "0.28.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"picomatch": "4.0.7"
	}
}
